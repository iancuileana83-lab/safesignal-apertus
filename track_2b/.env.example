# Copy to .env and fill in yourself. Never commit .env (it is git-ignored).

# --- Model endpoint (any OpenAI-compatible server) ---
# Public AI gateway (hosted Apertus):  https://api.publicai.co/v1   (v1.5-8b returned HTTP 404 on 2026-10-15; v1.5-70b works)
# Local Apertus on your own server:    http://localhost:8000/v1
# Development stand-in (not Apertus):  http://localhost:8001/v1   (npm run standin)
LLM_NAME=swiss-ai/apertus-v1.5-70b
LLM_BASE_URL=https://api.publicai.co/v1
LLM_API_KEY=

# What the endpoint really is. The badge in the page depends on this.
#   gateway = hosted Public AI gateway   local = a server you run yourself
#   standin = development substitute, never shown as Apertus
BACKEND_KIND=gateway
BACKEND_LABEL=Public AI gateway

PORT=3000
